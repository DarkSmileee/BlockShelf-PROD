# Copy this file to .env for local development.
# The production installer writes /etc/blockshelf/.env automatically.

# Core Django settings
DJANGO_SECRET_KEY=change-me
DEBUG=True
SITE_ID=1
ALLOW_REGISTRATION=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Include scheme for CSRF trusted origins when not using localhost.
CSRF_TRUSTED_ORIGINS=http://localhost
TIME_ZONE=UTC

# Database (PostgreSQL default; uncomment SQLite fallback if needed)
DATABASE_URL=postgresql://blockshelf:change-me@localhost:5432/blockshelf
#DATABASE_URL=sqlite:///db.sqlite3
CONN_MAX_AGE=60

# Email defaults
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional integrations
REBRICKABLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limiting & security toggles
ENABLE_RATE_LIMITING=True
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_SIGNUP_ATTEMPTS=10
RATE_LIMIT_SIGNUP_WINDOW=3600
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=3600

ENABLE_ACCOUNT_LOCKOUT=True
LOGIN_ATTEMPT_LIMIT=5
LOCKOUT_DURATION_MINUTES=15

ENABLE_SECURITY_LOGGING=True
SHARE_LINK_DEFAULT_EXPIRY_DAYS=30

# File upload safeguards
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
MAX_UPLOAD_SIZE=52428800

# WhiteNoise cache max-age (1 week)
WHITENOISE_MAX_AGE=604800

# Allauth email verification (none, optional, mandatory)
ACCOUNT_EMAIL_VERIFICATION=none

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# Cloudflare Turnstile (enabled by default; supply keys when using Cloudflare)
TURNSTILE_ENABLED=True
TURNSTILE_SITE_KEY=cf_site_key
TURNSTILE_SECRET_KEY=cf_secret_key

# Production-only HTTPS flags (safe defaults for local dev)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin

