# ------------------------------------------------------------------------------
# BlockShelf Environment Template
# ------------------------------------------------------------------------------
# Copy this file to .env and tweak values for your environment.
# The Django settings module loads it automatically in development.
# ------------------------------------------------------------------------------

# Core Django settings
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC
SITE_ID=1

# Database
# Use SQLite for local development. Example PostgreSQL URL:
# postgresql://blockshelf:password@localhost:5432/blockshelf
DATABASE_URL=sqlite:///db.sqlite3

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=blockshelf@example.com

# Application flags
ALLOW_REGISTRATION=True
REBRICKABLE_API_KEY=
ACCOUNT_EMAIL_VERIFICATION=none

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Rate limiting / security (override as needed)
ENABLE_RATE_LIMITING=True
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_SIGNUP_ATTEMPTS=10
RATE_LIMIT_SIGNUP_WINDOW=3600
RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=3600

ENABLE_ACCOUNT_LOCKOUT=True
LOGIN_ATTEMPT_LIMIT=5
LOCKOUT_DURATION_MINUTES=15

SHARE_LINK_DEFAULT_EXPIRY_DAYS=30
ENABLE_SECURITY_LOGGING=True

# File uploads
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
MAX_UPLOAD_SIZE=52428800
ENABLE_CLAMAV_SCAN=False

# WhiteNoise caching (seconds)
WHITENOISE_MAX_AGE=604800

# Production-only overrides (leave empty locally)
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
SECURE_REFERRER_POLICY=
